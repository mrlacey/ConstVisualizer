<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Properties\AssemblyInfo.cs sets the assembly attributes, so the SDK must not generate them as well. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The build workflow looks for the test assembly next to the VSIX, and the instructions use bin\Debug. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.IO.Redist" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.Analyzers" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="WarnAboutTODOs" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConstVisualizer\ConstVisualizer.csproj" />
  </ItemGroup>

</Project>
